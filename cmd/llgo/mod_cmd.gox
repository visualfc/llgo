import self "github.com/xgo-dev/llgo/cmd/internal/mod"

use "mod <command> [arguments]"

short "Manage modules using the Go toolchain"

// Go owns the module subcommands and flags; forward them without Cobra parsing.
flagOff

run args => {
	self.Main args
}
