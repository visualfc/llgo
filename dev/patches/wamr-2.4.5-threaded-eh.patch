WAMR 2.4.5: do not broadcast catchable intra-Wasm exceptions to other threads.
LLGo regression: internal/build/testdata/wasm-wasi-goexit-defer.
The terminal uncaught-exception path still publishes a cluster-wide trap.

diff --git a/core/iwasm/interpreter/wasm_interp_classic.c b/core/iwasm/interpreter/wasm_interp_classic.c
index 9f7e03e2..61fccd76 100644
--- a/core/iwasm/interpreter/wasm_interp_classic.c
+++ b/core/iwasm/interpreter/wasm_interp_classic.c
@@ -1933,6 +1933,19 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
                             *((int32 *)(prev_frame->sp)) = exception_tag_index;
                             prev_frame->sp++;
 
+                            /* Keep a catchable exception inside this Wasm
+                             * invocation. Publishing it through
+                             * wasm_set_exception would cancel every thread in
+                             * the cluster before the caller can catch it. */
+                            if (prev_frame->ip) {
+                                FREE_FRAME(exec_env, frame);
+                                wasm_exec_env_set_cur_frame(exec_env,
+                                                            prev_frame);
+                                RECOVER_CONTEXT(prev_frame);
+                                exception_tag_index = POP_I32();
+                                goto find_a_catch_handler;
+                            }
+
                             /* mark frame as raised exception */
                             wasm_set_exception(module,
                                                "uncaught wasm exception");
