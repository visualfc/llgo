{
	"llvm-target": "wasm32-unknown-emscripten",
	"cpu": "generic",
	"features": "+bulk-memory,+mutable-globals,+nontrapping-fptoint,+sign-ext,-multivalue,-reference-types",
	"build-tags": ["llgo.wasm.emscripten"],
	"goos": "js",
	"goarch": "wasm",
	"wasm-abi": "emscripten",
	"linker": "emcc",
	"cflags": [
		"-mbulk-memory",
		"-mnontrapping-fptoint",
		"-mno-multivalue",
		"-mno-reference-types",
		"-msign-ext"
	],
	"emulator": "node \"{root}/targets/emscripten-runner.mjs\" \"{}\""
}
