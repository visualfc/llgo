{
	"llvm-target":   "wasm32-unknown-unknown",
	"cpu":           "generic",
	"features":      "+mutable-globals,+nontrapping-fptoint,+sign-ext,-multivalue,-reference-types",
	"build-tags":    ["tinygo.wasm", "wasm_unknown", "llgo.wasm.freestanding"],
	"buildmode":    "c-shared",
	"goos":          "linux",
	"goarch":        "arm",
	"wasm-abi":      "freestanding",
	"linker":        "wasm-ld",
	"rtlib":         "compiler-rt",
	"scheduler":     "none",
	"gc":            "none",
	"default-stack-size": 4096,
	"cflags": [
		"-mnontrapping-fptoint",
		"-mno-multivalue",
		"-mno-reference-types",
		"-msign-ext"
	],
	"ldflags": [
		"--stack-first",
		"--no-demangle",
		"--no-entry"
	],
	"emulator":      "wasmtime run --dir={tmpDir}::/tmp {}"
}
